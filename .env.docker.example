# MIBA — Docker Compose environment. Copy to .env (never commit it) or run
#   ./scripts/docker-gen-env.sh
# which fills every secret below with fresh random values.
# Generate a secret by hand with:  openssl rand -hex 32
# Use hex/URL-safe values for the database passwords (they are embedded in URLs).

# ---- Public origin --------------------------------------------------------
# One origin serves both the storefront and the API. For a local trial use
# http://localhost:5000 (browsers accept the Secure cookies on localhost).
DOMAIN=miba.example.ir                    # used by the Caddy "proxy" profile
ACME_EMAIL=ops@example.ir                 # Let's Encrypt account e-mail (optional)
CLIENT_URL=https://miba.example.ir        # exact browser origin(s) allowed by CORS
APP_URL=https://miba.example.ir           # password-reset links
API_URL=https://miba.example.ir           # Zarinpal callback base (no /api suffix)
PUBLIC_SITE_URL=https://miba.example.ir   # SEO / canonical URLs (also baked into the SPA at build time)
# CORS_ALLOWED_ORIGINS=https://www.miba.example.ir

# Host binding for the app container. Keep 127.0.0.1 behind Caddy or another
# reverse proxy; the proxy profile reaches the app over the internal network.
APP_BIND=127.0.0.1
APP_PORT=5000
TRUST_PROXY_HOPS=1                        # Caddy (or one external proxy) in front; 0 if exposed directly

# ---- Databases (internal network only, never published) -------------------
MONGO_ROOT_USER=miba_root
MONGO_ROOT_PASSWORD=
MONGO_APP_DB=miba
MONGO_APP_USER=miba_app
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
# MONGO_MAX_POOL_SIZE=5

# ---- Application secrets (32+ random characters, all different) ----------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
RATE_LIMIT_KEY_SALT=
CRON_SECRET=                              # used by the bundled reconciliation worker
NEWSLETTER_TOKEN_SECRET=
READINESS_TOKEN=                          # header x-readiness-token for detailed /api/ready
# BCRYPT_COST=12

# ---- Payments (Zarinpal, IRT only) ---------------------------------------
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Checkout stays disabled until catalogue prices are confirmed to be whole Toman.
IRT_CATALOG_PRICES_CONFIRMED=false
# RECONCILE_INTERVAL_SECONDS=300

# ---- Media -----------------------------------------------------------------
# local: product/category images are stored in the "uploads" volume and served
# by the app. cloudinary: use the CLOUDINARY_* credentials instead.
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- E-mail (password reset, newsletter) ----------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---- Shipping defaults (Toman) ---------------------------------------------
# DEFAULT_SHIPPING_FEE=
# FREE_SHIPPING_THRESHOLD=

# ---- Public storefront settings (build time, baked into the bundle) -------
VITE_STORE_SUPPORT_EMAIL=
VITE_STORE_INSTAGRAM_URL=
VITE_STORE_TELEGRAM_URL=
VITE_STORE_X_URL=
VITE_ENAMAD_SEAL_IMAGE_URL=
VITE_ENAMAD_SEAL_LINK_URL=

# Never enable in production (startup validation rejects them):
# ALLOW_INSECURE_COOKIES=true
# ALLOW_DEV_ORIGINS=true
