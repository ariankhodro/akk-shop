# TLS-terminating reverse proxy (compose profile "proxy"). Caddy obtains and
# renews certificates for {$DOMAIN} automatically; DNS must point at this host
# and ports 80/443 must be reachable.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Product image data URLs are sent as JSON; the API enforces its own 10 MB cap.
	request_body {
		max_size 12MB
	}
	reverse_proxy app:5000 {
		# One trusted hop: matches TRUST_PROXY_HOPS=1 in the app.
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format json
	}
}

# Redirect the www. host to the apex domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
