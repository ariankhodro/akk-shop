# Backend environment template. Copy to .env (never commit .env). All values are placeholders.
NODE_ENV=production                       # production | development | test
PORT=5000
CLIENT_URL=https://shop.example.ir        # exact browser origin(s) allowed by CORS; extra: CORS_ALLOWED_ORIGINS=a,b
TRUST_PROXY_HOPS=1                        # reverse-proxy hops in front of the API (0-5)

MONGO_URI=mongodb://user:password@host:27017/shop?replicaSet=rs0   # replica set required (transactions)
REDIS_URL=rediss://default:password@host:6379                       # sessions, rate limits, locks

# 32+ random characters each, and different from one another:  openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
RATE_LIMIT_KEY_SALT=                      # 16+ random characters
CRON_SECRET=                              # 32+ random characters; bearer secret for /api/payments/reconcile-pending

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=https://shop.example.ir           # used in password-reset links (never taken from request headers)

# Local development only. Both are rejected by startup validation when NODE_ENV=production.
# ALLOW_INSECURE_COOKIES=true
# ALLOW_DEV_ORIGINS=true
