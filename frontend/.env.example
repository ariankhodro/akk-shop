# MIBA storefront build-time settings (baked into the bundle; never put secrets here).

# Public storefront origin used for canonical URLs and share previews.
VITE_PUBLIC_SITE_URL=

# Official support e-mail shown in the footer and support pages
# (customers also use it to request a wholesale/partner account).
VITE_STORE_SUPPORT_EMAIL=

# Optional storefront footer links. Set these to the real public profiles for MIBA.
VITE_STORE_INSTAGRAM_URL=
VITE_STORE_TELEGRAM_URL=
VITE_STORE_X_URL=

# Use the exact image/embed URL and verification URL issued for this shop by eNAMAD.
# Leave blank until the store has its own official seal; the UI will display a generic mark
# with a note that the official verification link has not been configured.
VITE_ENAMAD_SEAL_IMAGE_URL=
VITE_ENAMAD_SEAL_LINK_URL=
